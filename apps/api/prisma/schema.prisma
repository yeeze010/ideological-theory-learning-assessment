generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  status    String   @default("enabled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgs    Org[]
  users   User[]
  courses Course[]
}

model Org {
  id        String   @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@index([tenantId, parentId])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  orgId        String
  username     String
  passwordHash String
  name         String
  status       String   @default("enabled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  org    Org    @relation(fields: [orgId], references: [id])
  roles  UserRole[]
  answerDiagnostics AnswerDiagnostic[]
  profileSnapshots  LearningProfileSnapshot[]
  recommendations   LearningRecommendation[]
  alerts            LearningAlert[]

  @@unique([tenantId, username])
  @@index([tenantId, orgId])
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  scopeType String   @default("tenant")
  scopeId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([roleId, scopeType, scopeId])
}

model Course {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  category        String
  status          String   @default("draft")
  requiredMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  chapters CourseChapter[]
  exams    ExamPlan[]

  @@index([tenantId, status])
}

model CourseChapter {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  sort            Int      @default(0)
  requiredMinutes Int      @default(20)

  course Course @relation(fields: [courseId], references: [id])
}

model Question {
  id         String   @id @default(uuid())
  bankName   String
  type       String
  difficulty String
  stem       String
  options    Json
  answer     Json
  knowledgePoints Json     @default("[]")
  score      Int      @default(10)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  answerDiagnostics AnswerDiagnostic[]

  @@index([bankName, type, difficulty])
}

model ExamPlan {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  status          String   @default("draft")
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  passScore       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id])
  attempts ExamAttempt[]
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examPlanId  String
  userId      String
  answers     Json
  totalScore  Int       @default(0)
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  examPlan ExamPlan @relation(fields: [examPlanId], references: [id])

  @@index([examPlanId, userId])
}

model KnowledgePoint {
  id        String   @id @default(uuid())
  courseId  String?
  name      String
  parentId  String?
  weight    Int      @default(1)
  createdAt DateTime @default(now())

  diagnostics AnswerDiagnostic[]

  @@unique([courseId, name])
  @@index([courseId, parentId])
}

model AnswerDiagnostic {
  id               String   @id @default(uuid())
  learnerId        String
  questionId       String
  knowledgePointId String
  score            Int
  maximumScore     Int
  durationSeconds  Int      @default(0)
  answeredAt       DateTime @default(now())
  isWrong          Boolean  @default(false)

  learner        User           @relation(fields: [learnerId], references: [id])
  question       Question       @relation(fields: [questionId], references: [id])
  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id])

  @@index([learnerId, knowledgePointId, answeredAt])
  @@index([questionId, isWrong])
}

model LearningProfileSnapshot {
  id             String   @id @default(uuid())
  learnerId      String
  periodKey      String
  overallMastery Int
  studyMinutes   Int
  completedTasks Int
  pendingTasks   Int
  riskLevel      String
  diagnostics    Json
  createdAt      DateTime @default(now())

  learner User @relation(fields: [learnerId], references: [id])

  @@unique([learnerId, periodKey])
  @@index([riskLevel, createdAt])
}

model LearningRecommendation {
  id             String   @id @default(uuid())
  learnerId      String
  type           String
  title          String
  knowledgePoint String
  reason         String
  priority       String
  status         String   @default("pending_review")
  reviewTaskId   String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  learner User @relation(fields: [learnerId], references: [id])

  @@index([learnerId, status, priority])
}

model LearningAlert {
  id          String   @id @default(uuid())
  learnerId   String
  level       String
  title       String
  reason      String
  ownerRole   String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  learner User @relation(fields: [learnerId], references: [id])

  @@index([ownerRole, status, level])
  @@index([learnerId, status])
}

model ReviewTask {
  id          String   @id @default(uuid())
  type        String
  title       String
  submittedBy String
  targetRole  String
  status      String   @default("pending")
  comment     String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewerId  String?

  @@index([targetRole, status, createdAt])
}
